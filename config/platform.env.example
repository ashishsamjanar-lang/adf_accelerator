# =============================================================================
# ADF Pipeline Accelerator — the ONE runtime-parameter file for every service.
# =============================================================================
# Copy to config/platform.env (git-ignored; `make setup` does this) and edit.
#
# Who reads it:
#   * api (backend/app/config.py) and worker (worker/app/config.py) — resolved
#     from the repo root, so it works whatever directory you start them from.
#   * frontend — `npm run dev`/`npm run build` load it via frontend/next.config.ts.
#   * docker compose — `env_file:` injects it into every container.
#   * Deployments (Container Apps / Helm) set the SAME key names as environment
#     variables; a real environment variable always wins over this file.
# Set PLATFORM_ENV_FILE=/path/to/other.env to point the api/worker/frontend at a
# different file (e.g. one per environment).
#
# Secrets: only local-dev values belong here. In QA/PROD, DATABASE_URL,
# GIT_TOKEN and GIT_TOKEN_FERNET_KEY come from Key Vault / a k8s Secret.
# Never commit a real secret.

# --- Application -------------------------------------------------------------
APP_ENV=local
APP_NAME=adf-accelerator
LOG_LEVEL=INFO

# --- Metastore (Postgres) ----------------------------------------------------
POSTGRES_DB=accelerator
POSTGRES_USER=accelerator
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+psycopg://accelerator:change-me-local-only@postgres:5432/accelerator
# SQLAlchemy pool per api process (10 + 10 = 20 connections covers ~25 active
# users on one replica). Raise for more replicas, lower for a small Postgres.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# --- API ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# --- Frontend ----------------------------------------------------------------
# Server-only: where the frontend's same-origin /api proxy (frontend/middleware.ts)
# forwards to. Read per request, so one built image works in every environment.
# Docker compose: http://api:8000. `npm run dev` on your machine: http://localhost:8000.
BACKEND_INTERNAL_URL=http://api:8000
# Leave empty (normal case): the browser calls this app's own origin and the
# proxy above forwards. Setting it bakes a direct API origin into the client
# bundle at build time (Next.js NEXT_PUBLIC_* rule).
NEXT_PUBLIC_API_BASE_URL=

# --- Sign-in -----------------------------------------------------------------
# password — username (or email) + password, cookie sessions. Accounts are
#            created by a platform admin in Administration → Users; there is no
#            self sign-up. Bootstrap the first admin once from the backend:
#              docker compose run --rm api python -m app.manage create-platform-admin \
#                --email you@example.com --name "Your Name" --username you
# mock     — no sign-in, dev/demo/CI only (acts as the seeded platform admin).
# oidc | saml — SSO, scaffolded only (backend/app/identity/); every request 501s.
AUTH_MODE=password
AUTH_IDLE_TIMEOUT_MINUTES=30
AUTH_ABSOLUTE_TIMEOUT_HOURS=12
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_MIN_PASSWORD_LENGTH=8
# SSO only (not implemented yet): public origin the identity provider redirects
# back to, e.g. https://adf-forge.contoso.com. Per-provider settings (issuer,
# client id, Key Vault secret reference, group→role mappings) are managed in
# Administration → Users → SSO, not here.
SSO_CALLBACK_BASE_URL=

# --- Worker ------------------------------------------------------------------
# Seconds between polls of the jobs table, and attempts before a job is failed.
WORKER_POLL_INTERVAL=2.0
WORKER_MAX_ATTEMPTS=3

# --- Azure / Git ---------------------------------------------------------------
KEY_VAULT_NAME=replace-with-key-vault-name
ADF_SUBSCRIPTION_ID=replace-with-subscription-id
ADF_RESOURCE_GROUP=replace-with-resource-group
ADF_FACTORY_NAME=replace-with-factory-name
SOURCE_REPOSITORY_URL=https://github.com/example/adf-accelerator-artifacts
# Fallback Git credential for the worker when a push carries no token of its own
# and no per-project Key Vault reference resolves. Blank = offline SimulatedAdapter.
GIT_TOKEN=
# Encrypts a per-push Git token at rest between api and worker; must be identical
# in both. Blank is allowed for APP_ENV=local only (a published dev key is used).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GIT_TOKEN_FERNET_KEY=

# --- Audit -------------------------------------------------------------------
# audit_log retention in days, purged only by `python -m app.manage purge-audit-log`.
AUDIT_RETENTION_DAYS=400
