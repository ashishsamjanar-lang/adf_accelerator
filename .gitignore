# Dummy/test data generated by test runs (E2E specs write workbooks, drafts and
# findings under test-results/; committed fixtures under */tests/fixtures/ and
# frontend/e2e/fixtures/ are inputs the suites need and stay tracked)
frontend/e2e/.output/
backend/tests/.output/
worker/tests/.output/
.run-*

# Office lock/temp files left by opening fixture workbooks in Excel
~$*

# Logs (incl. local dev-server logs like .backend.log)
*.log
.*.log

# Generated artifacts
artifacts/generated/

# Local tool state
tmp/
temp/

