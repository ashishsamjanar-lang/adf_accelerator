{
  "name": "vendor_hub",
  "projectId": "proj-parity-test",
  "templateId": "metadata_driven_load",
  "sourceType": "sql_server",
  "sourceObject": "dbo.vendor",
  "targetType": "azure_data_lake_storage_gen2",
  "targetPath": "/vendor/",
  "sourceObjectMode": "form",
  "sourceObjects": [
    {
      "object": "dbo.vendor",
      "watermarkColumn": "modified_date",
      "columnMappings": [
        { "source": "VENDOR_NM", "sink": "vendor_name" },
        { "source": "VENDOR_CD", "sink": "vendor_code" }
      ]
    },
    { "object": "dbo.vendor_site", "watermarkColumn": "modified_date" },
    {
      "object": "dbo.vendor_contact",
      "watermarkColumn": "modified_date",
      "columnMappings": [{ "source": "CONTACT_NM", "sink": "contact_name" }]
    }
  ],
  "columnMappings": [{ "source": "SITE_NM", "sink": "site_name" }],
  "copyTypeConversion": true,
  "watermarkEnabled": true,
  "watermarkType": "single",
  "watermarkColumns": [{ "name": "modified_date", "type": "datetime", "order": 1 }],
  "watermarkTable": "control.watermarks",
  "watermarkInitialValue": "1900-01-01",
  "loadTypeMode": "incremental",
  "masterChildPattern": true,
  "isSequential": false,
  "batchCount": 15,
  "parallelCopies": 10,
  "enableCopyLog": true,
  "logLevel": "Info",
  "sinkFileFormat": "Parquet",
  "childDispatch": [{ "matchValue": "finance", "childPipelineName": "PL_finance_child" }]
}
