{
  "name": "product_hub_orchestrator",
  "projectId": "proj-parity-test",
  "templateId": "metadata_driven_load",
  "sourceType": "sql_server",
  "sourceObject": "dbo.product",
  "targetType": "azure_data_lake_storage_gen2",
  "targetPath": "/product/",
  "sourceObjectMode": "form",
  "sourceObjects": [
    { "object": "dbo.product", "watermarkColumn": "modified_date" },
    { "object": "dbo.product_category", "watermarkColumn": "modified_date" },
    { "object": "dbo.product_price", "watermarkColumn": "modified_date" }
  ],
  "watermarkEnabled": true,
  "watermarkType": "single",
  "watermarkColumns": [{ "name": "modified_date", "type": "datetime", "order": 1 }],
  "watermarkTable": "control.watermarks",
  "watermarkInitialValue": "1900-01-01",
  "loadTypeMode": "incremental",
  "masterChildPattern": true,
  "isSequential": false,
  "batchCount": 15,
  "parallelCopies": 10,
  "dataIntegrationUnits": 8,
  "enableStaging": true,
  "stagingLinkedService": "LS_staging_blob",
  "stagingPath": "staging/product_hub/",
  "stagingEnableCompression": true,
  "retryCount": 3,
  "retryIntervalInSeconds": 30,
  "redirectIncompatibleRows": true,
  "rejectsLinkedService": "LS_rejects_blob",
  "rejectsPath": "rejects/product_hub/",
  "rowCountValidationEnabled": true,
  "dataQualityRules": [{ "name": "product_id_not_null", "column": "product_id", "rule": "NOT NULL" }],
  "notifyOnSuccess": true,
  "notifyOnFailure": true,
  "notificationEmails": ["data-eng@example.com", "product-team@example.com"],
  "enableCopyLog": true,
  "logLevel": "Info",
  "enableAzureMonitor": true,
  "sinkFileFormat": "Parquet",
  "customMetadata": [{ "name": "_source_system", "value": "COMMERCE" }]
}
