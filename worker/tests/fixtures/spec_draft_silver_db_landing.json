{
  "name": "patient_curated",
  "projectId": "proj-parity-test",
  "templateId": "metadata_driven_load",
  "sourceType": "sql_server",
  "sourceSystem": "epic",
  "sourceObject": "dbo.PATIENT",
  "targetType": "azure_sql_database",
  "targetPath": "",
  "sourceObjectMode": "form",
  "sourceObjects": [{ "object": "dbo.PATIENT" }, { "object": "dbo.PATIENT_ALIAS", "loadingBehavior": "FullLoad" }],
  "watermarkEnabled": true,
  "watermarkType": "single",
  "watermarkColumns": [{ "name": "UPDATE_DATE", "type": "datetime", "order": 1 }],
  "watermarkTable": "control.watermarks",
  "watermarkInitialValue": "1900-01-01",
  "loadTypeMode": "incremental",
  "masterChildPattern": true,
  "isSequential": false,
  "batchCount": 10,
  "parallelCopies": 8,
  "retryCount": 2,
  "retryIntervalInSeconds": 15,
  "enableCopyLog": true,
  "logLevel": "Info",
  "enableAzureMonitor": true,
  "sinkFileFormat": "Parquet",
  "copyBehavior": "PreserveHierarchy",
  "writeBehavior": "Insert",
  "truncateTarget": true,
  "medallionLayer": "silver",
  "curatedEntity": "patient",
  "transformations": [
    { "name": "patient_history", "type": "scd2", "keyColumns": "PAT_ID", "orderColumn": "UPDATE_DATE", "columns": "PAT_NAME" }
  ]
}
