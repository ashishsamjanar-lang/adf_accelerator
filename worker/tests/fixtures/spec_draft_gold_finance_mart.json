{
  "name": "gl_fact_mart",
  "projectId": "proj-parity-test",
  "templateId": "metadata_driven_load",
  "sourceType": "sql_server",
  "sourceObject": "curated.gl_transaction",
  "targetType": "azure_data_lake_storage_gen2",
  "targetPath": "/mart/gl_fact/",
  "sourceObjectMode": "form",
  "sourceObjects": [{ "object": "curated.gl_transaction" }],
  "watermarkEnabled": true,
  "watermarkType": "single",
  "watermarkColumns": [{ "name": "modified_date", "type": "datetime", "order": 1 }],
  "watermarkTable": "control.watermarks",
  "watermarkInitialValue": "1900-01-01",
  "loadTypeMode": "incremental",
  "masterChildPattern": true,
  "isSequential": false,
  "batchCount": 10,
  "parallelCopies": 8,
  "retryCount": 2,
  "retryIntervalInSeconds": 15,
  "enableCopyLog": true,
  "logLevel": "Info",
  "enableAzureMonitor": true,
  "sinkFileFormat": "Parquet",
  "copyBehavior": "PreserveHierarchy",
  "writeBehavior": "Insert",
  "medallionLayer": "gold",
  "curatedEntity": "gl_fact",
  "martDomain": "finance",
  "generateLineage": true,
  "transformations": [
    { "name": "join_customer", "type": "join", "joinEntity": "curated.customer", "joinType": "LEFT", "joinCondition": "a.customer_id = b.customer_id" },
    { "name": "agg_gl", "type": "aggregate", "groupByColumns": "customer_id, posted_month", "aggregateExpression": "SUM(amount) AS total_amount" }
  ]
}
