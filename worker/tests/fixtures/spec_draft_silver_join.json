{
  "name": "gl_transaction_enriched",
  "projectId": "proj-parity-test",
  "templateId": "metadata_driven_load",
  "sourceType": "sql_server",
  "sourceObject": "dbo.gl_transaction",
  "targetType": "azure_data_lake_storage_gen2",
  "targetPath": "/gl_transaction_enriched/",
  "sourceObjectMode": "form",
  "sourceObjects": [{ "object": "dbo.gl_transaction" }],
  "watermarkEnabled": true,
  "watermarkType": "single",
  "watermarkColumns": [{ "name": "modified_date", "type": "datetime", "order": 1 }],
  "watermarkTable": "control.watermarks",
  "watermarkInitialValue": "1900-01-01",
  "loadTypeMode": "incremental",
  "masterChildPattern": true,
  "isSequential": false,
  "batchCount": 10,
  "parallelCopies": 8,
  "retryCount": 2,
  "retryIntervalInSeconds": 15,
  "enableCopyLog": true,
  "logLevel": "Info",
  "enableAzureMonitor": true,
  "sinkFileFormat": "Parquet",
  "copyBehavior": "PreserveHierarchy",
  "writeBehavior": "Insert",
  "medallionLayer": "silver",
  "curatedEntity": "gl_transaction_enriched",
  "transformations": [
    { "name": "conform_gl_columns", "type": "conform_columns", "columns": "TransactionId:transaction_id, Amount:amount" },
    {
      "name": "join_cost_center",
      "type": "join",
      "joinEntity": "raw.sql_server_cost_center",
      "joinType": "LEFT",
      "joinCondition": "a.cost_center_id = b.cost_center_id"
    },
    { "name": "dedupe_gl", "type": "dedupe", "keyColumns": "transaction_id", "orderColumn": "modified_date" }
  ]
}
